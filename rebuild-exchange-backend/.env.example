# ==============================================================================
# ReBuild Exchange - Environment Variables Template
# Copy this file to .env in rebuild-exchange-backend/ or configure in your IDE
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rebuild_exchange
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Security
# Must be at least 256 bits (32 bytes) hex-encoded
JWT_SECRET=4c81a28723c0dc89ef48b671d1796d8e8bfa6939e6a394f4a3be9e4df1cf45bf

# Email OTP SMTP Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Gateway (Razorpay Sandbox/Test mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
